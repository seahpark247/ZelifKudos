# Database
DB_NAME=
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Email (optional — app runs without it, but weekly emails and magic links won't send)
SMTP_HOST=
# 465 = implicit TLS (SMTP_SSL=true), 587 = STARTTLS (SMTP_STARTTLS=true).
# Set exactly one of the two flags to true, matching the port.
SMTP_PORT=587
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Product name shown in the UI, PWA manifest and outbound email.
# Quote it — run.sh sources this file, so an unquoted space would break parsing.
# Unset falls back to "Kudos".
APP_NAME="Kudos"

# IANA timezone driving the Friday email and the nightly nickname reset.
APP_TIMEZONE=UTC

# Cron schedules. Quote them — they contain spaces, and run.sh sources this file.
# Defaults are Friday 18:00 and midnight in APP_TIMEZONE.
#WEEKLY_EMAIL_CRON="0 0 18 ? * FRI"
#NICKNAME_RESET_CRON="0 0 0 * * ?"

# Access control — only this email domain may request a magic link.
# Required: if unset, login is refused outright.
COMPANY_EMAIL_DOMAIN=yourcompany.com

# The single account allowed to grant itself admin (bootstrap escape hatch).
# Leave empty to disable self-promotion entirely.
SUPER_ADMIN_EMAIL=

# Absolute base URL used to build magic links in production emails.
# MUST be set in production or login links will point at localhost.
SERVER_URL=

# Port the app listens on (default 7777). Stay below 32768 so it never collides
# with the ephemeral port range. Must match the port in SERVER_URL above.
SERVER_PORT=7777
